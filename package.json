{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "build:render": "NITRO_PRESET=node vite build --config vite.render.config.ts",
    "start:render": "node scripts/start-render.mjs",
    "test:deposit-evidence-postgres": "node --test scripts/verify-isolated-postgres-deposit-evidence.mjs",
    "test:game-wallet-postgres": "node --experimental-transform-types --test scripts/verify-isolated-postgres-generic-wallet.mjs",
    "test:render-db": "node --test tests/render-d1.test.mjs",
    "test:maintenance": "node --test --test-concurrency=1 tests/maintenance-*.test.mjs",
    "test:release-probe": "node --test tests/production-readiness-probe.test.mjs tests/liveness.test.mjs tests/official-entries-probe.test.mjs",
    "test:database-readiness": "node --test tests/postgres-readiness-gate.test.mjs",
    "test:all": "node --test --test-concurrency=4 tests/*.test.mjs",
    "typecheck:render": "tsc --noEmit -p tsconfig.render.json",
    "verify:render": "npm run test:maintenance && npm run test:release-probe && npm run test:all && npm run typecheck:render && npm run lint && npm run test:render-db && npm run build:render",
    "probe:production": "EXPECTED_RELEASE_PREFIX=17.0.0-selfbuilt.173-staff-setup-route node scripts/production-readiness-probe.mjs",
    "probe:database": "MASTER7_EXPECTED_RELEASE=17.0.0-selfbuilt.173-staff-setup-route node scripts/postgres-readiness-gate.mjs",
    "accounting:close": "node scripts/accounting-close.mjs",
    "backup:restore-dry-run": "node scripts/postgres-restore-dry-run.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "probe:entries": "MASTER7_EXPECTED_RELEASE=17.0.0-selfbuilt.173-staff-setup-route node scripts/probe-official-entries.mjs",
    "test:manual-bank-postgres": "node --experimental-transform-types --test scripts/verify-isolated-postgres-manual-bank.mjs",
    "test:provider-wallet-postgres": "node --experimental-transform-types --test scripts/verify-isolated-postgres-provider-wallet.mjs",
    "test:acceptance-integrity-postgres": "node --experimental-transform-types --test scripts/verify-isolated-postgres-acceptance-integrity.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
