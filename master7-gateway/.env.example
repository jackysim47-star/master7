# Public, non-secret gateway configuration
PUBLIC_BASE_URL=https://master7-integration-gateway.onrender.com
ALLOWED_ORIGINS=https://master7.best,https://www.master7.best,https://master7.site,https://www.master7.site,https://master7-v17-staging.onrender.com

# Legacy route safety gate. The public /providers/megah5/games catalogue stays
# readable, but session, balance, deposit, withdraw and transfer-status remain
# closed until the exact supplier brand/account mapping is independently verified.
MEGA_PROVIDER_MAPPING_VERIFIED=false
MEGA_TRANSFERS_ENABLED=false
MEGA_TRANSFER_STATUS_ENABLED=false

# META GAMING API v3.4.8 has separate normal and free-credit accounts. Keep the
# credentials in Render secret variables. Runtime routes stay independently gated.
META_GAMING_NORMAL_BASE_URL=https://smapi.xystem138.com/api/opgateway/v1/op
META_GAMING_NORMAL_OPERATOR_ID=
META_GAMING_NORMAL_SECRET_KEY=
META_GAMING_NORMAL_CURRENCY=MYR
META_GAMING_FREE_BASE_URL=https://smapi.xystem138.com/api/opgateway/v1/op
META_GAMING_FREE_OPERATOR_ID=
META_GAMING_FREE_SECRET_KEY=
META_GAMING_FREE_CURRENCY=MYR

# Isolated peer credentials for the compiled runtime routes.
PLATFORM_METAGAMING_PLAYER_TOKEN=
PLATFORM_METAGAMING_WALLET_TOKEN=
PLATFORM_METAGAMING_RECOVERY_TOKEN=
PLATFORM_METAGAMING_REPORT_TOKEN=

# Every switch remains false until its exact profile has provider authorization,
# contract evidence, controlled UAT and platform acceptance.
META_GAMING_PLAYER_ENABLED=false
META_GAMING_LAUNCH_ENABLED=false
META_GAMING_BALANCE_ENABLED=false
META_GAMING_TRANSFER_ENABLED=false
META_GAMING_TRANSFER_STATUS_ENABLED=false
META_GAMING_KICK_ENABLED=false
META_GAMING_UNFINISHED_ROUND_ENABLED=false
META_GAMING_REPORT_ENABLED=false
META_GAMING_FLAG_LOG_ENABLED=false

# VPay provider secrets and isolated platform scopes.
VPAY_TRADER_ID=
VPAY_API_TOKEN=
PLATFORM_CALLBACK_TOKEN=
PLATFORM_QUERY_TOKEN=
PLATFORM_ORDER_TOKEN=
PLATFORM_PAYOUT_TOKEN=
VPAY_PAYMENT_FORWARD_URL=https://master7-v17-staging.onrender.com/api/payment-callbacks/vpay/payment
VPAY_RETURN_URL=https://master7-v17-staging.onrender.com/payment/return
VPAY_WITHDRAWAL_FORWARD_URL=https://master7-v17-staging.onrender.com/api/payment-callbacks/vpay/withdrawal
VPAY_WITHDRAWALS_ENABLED=false

# GSPAY provider secrets belong only in Render secret environment variables.
# Never commit real credential or platform-token values to this file.
GSPAY_MODE=production
GSPAY_OPERATOR_AUTH_KEY=
GSPAY_OPERATOR_SECRET_KEY=

# Separate platform capability tokens, each at least 32 random bytes.
PLATFORM_GSPAY_ORDER_TOKEN=
PLATFORM_GSPAY_QUERY_TOKEN=
PLATFORM_GSPAY_CALLBACK_TOKEN=

# Gateway-to-portal callback targets. They remain inactive until the supplier
# confirms its callback acknowledgement/retry contract.
GSPAY_PAYMENT_FORWARD_URL=https://master7-v17-staging.onrender.com/api/payment-callbacks/gspay/payment
GSPAY_DUITNOW_FORWARD_URL=https://master7-v17-staging.onrender.com/api/payment-callbacks/gspay/duitnow

# Money routes are fail-closed. Do not turn these on from an example file.
GSPAY_MYR_ORDERS_ENABLED=false
GSPAY_MYR_QUERIES_ENABLED=false
GSPAY_MYR_CALLBACKS_ENABLED=false

# RSGHub read-only game catalogue. Production credentials remain in Render
# secret environment variables; this adapter does not expose wallet or launch.
RSGHUB_BASE_URL=https://api.rsghub.io
RSGHUB_CLIENT_ID=
RSGHUB_CLIENT_SECRET=
RSGHUB_DES_KEY=
RSGHUB_DES_IV=
RSGHUB_SYSTEM_CODE=
RSGHUB_CURRENCY=MYR

# JDB read-only game catalogue (Action 49). Production credentials belong only
# in Render secret environment variables. No wallet or player action is used.
JDB_BASE_URL=
JDB_DC=
JDB_AES_KEY=
JDB_AES_IV=
JDB_AGENT_ID=

# Pragmatic Play read-only GetCasinoGames catalogue. Production credentials
# stay in Render and are never returned by this service.
PRAGMATIC_BASE_URL=https://api-2104.api-pp.net
PRAGMATIC_SECURE_LOGIN=
PRAGMATIC_SECRET_KEY=
