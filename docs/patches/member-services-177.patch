+// These steps name real member controls. Do not ask for a transaction reference
+// when the customer simply needs help finding a page.
+function navigationGuidance(message:string,language:string):string|null{
+ const question=/怎么|如何|哪里|哪裡|在哪|不会|不會|找不到|怎样|怎樣|where|how|find|di mana|bagaimana/i.test(message);
+ let key:string|null=null;
+ if(/^(?:hi|hello|hey|你好|您好|嗨|哈啰|哈囉|hai|helo)[!！,.，。\s]*$/iu.test(message.trim()))key='hello';
+ else if(/身份|verification|verify|pengesahan/i.test(message)&&question)key='verification';
+ else if(/菜单|菜單|menu|navigation|导航|導航/i.test(message))key='menu';
+ else if(/记录|紀錄|records?|history|rekod/i.test(message)&&question)key='records';
+ else if(/充值|deposit|top.?up|tambah nilai/i.test(message)&&question)key='deposit';
+ else if(/提款|withdraw|pengeluaran/i.test(message)&&question)key='withdraw';
+ else if(/密码|密碼|password|kata laluan/i.test(message)&&question)key='security';
+ if(!key)return null;
+ const help:Record<string,Record<string,string>>={
+  hello:{zh:'你好，我是 Stephanie。你可以问我：菜单在哪里、如何申请身份审核、如何查看充值或提款记录。需要人工时，请点击聊天窗口的“转人工客服”。',en:'Hello, I am Stephanie. Ask me where to find the menu, identity verification, or deposit and withdrawal records. Choose “Request a person” in this chat if you need the team.',ms:'Hai, saya Stephanie. Tanya tentang menu, pengesahan identiti, atau rekod deposit dan pengeluaran. Pilih “Minta pegawai” untuk bantuan pasukan.'},
+  menu:{zh:'手机：点页面顶部“菜单”，钱包、提款、充值记录、身份审核和账户安全都在里面。电脑：使用左侧导航，或顶部“菜单”。钱包下方也有“身份审核”和“客服聊天”快捷入口。',en:'On mobile, tap “Menu” at the top. It contains your wallet, withdrawals, deposit records, verification and account security. On desktop, use the left navigation or the top Menu. Verification and support shortcuts also appear below your wallet.',ms:'Pada telefon, tekan “Menu” di atas untuk dompet, pengeluaran, rekod, pengesahan dan keselamatan. Pada komputer, gunakan navigasi kiri atau Menu atas. Pintasan pengesahan dan sokongan juga ada di bawah dompet.'},
+  verification:{zh:'请用会员账号登录，然后点“菜单 → 身份审核 → 申请审核”。提交后等待后台人工核验；申请不等于审核通过。请通过客服规定的核验流程处理资料，不要在聊天中发送证件号码、密码或验证码。',en:'Sign in with your member account, then choose “Menu → Identity verification → Request review”. The team must complete the manual review; submitting is not approval. Follow the support verification process and do not send document numbers, passwords or OTPs in chat.',ms:'Log masuk sebagai ahli, kemudian pilih “Menu → Pengesahan identiti → Mohon semakan”. Pasukan perlu membuat semakan manual; permintaan bukan kelulusan. Jangan hantar nombor dokumen, kata laluan atau OTP dalam sembang.'},
+  records:{zh:'查看充值记录：点“菜单 → 充值记录”，或主钱包的“记录”。查看提款记录：点“菜单 → 提款与提款记录”。状态以记录页显示为准；如果金额未更新，请提供记录编号并转人工核对。',en:'For deposit records, choose “Menu → Deposit records” or Records in the wallet. For withdrawals, choose “Menu → Withdraw & withdrawal records”. Use the status shown there; request a person with the record ID if a balance needs checking.',ms:'Untuk deposit, pilih “Menu → Rekod deposit” atau Rekod dalam dompet. Untuk pengeluaran, pilih “Menu → Pengeluaran & rekod”. Semak status sebenar di situ; berikan ID rekod kepada pegawai jika baki perlu disemak.'},
+  deposit:{zh:'点主钱包的“充值”，或“菜单 → 充值”，再选择可用付款通道。如果提示不可用，请勿重复付款；先查看充值记录或转人工客服。收款结果和钱包入账需要系统记录确认。',en:'Choose Deposit in the wallet or “Menu → Deposit”, then select an available method. If it is unavailable, do not make another payment; check your records or request a person. Payment and wallet credit require confirmation in the records.',ms:'Pilih Deposit dalam dompet atau “Menu → Deposit”, kemudian kaedah yang tersedia. Jika tidak tersedia, jangan bayar sekali lagi; semak rekod atau minta pegawai. Bayaran dan kredit dompet mesti disahkan dalam rekod.'},
+  withdraw:{zh:'点“菜单 → 提款与提款记录”。先查看可用余额、身份审核状态及通道提示，再填写本人收款资料。最低金额、手续费和是否受理必须以当前通道确认结果为准；AI 不会代你批准或提交提款。',en:'Choose “Menu → Withdraw & withdrawal records”. Check available funds, verification and channel availability before entering your own recipient details. Minimums, fees and acceptance must be confirmed by the current provider. The assistant does not approve or submit withdrawals.',ms:'Pilih “Menu → Pengeluaran & rekod”. Semak baki, pengesahan dan saluran sebelum mengisi butiran penerima sendiri. Minimum, fi dan penerimaan mesti disahkan oleh penyedia semasa. Pembantu tidak meluluskan atau menghantar pengeluaran.'},
+  security:{zh:'使用会员密码登录后，点“菜单 → 账户安全”进入修改资料或密码的页面。不要把密码、旧密码或验证码发送给客服或聊天机器人。',en:'After signing in with your member password, choose “Menu → Account security” to update your details or password. Do not send passwords or OTPs to support or a chatbot.',ms:'Selepas log masuk dengan kata laluan ahli, pilih “Menu → Keselamatan akaun” untuk mengemas kini butiran. Jangan hantar kata laluan atau OTP kepada sokongan atau bot.'}
+ };
+ return help[key][language]??help[key].en;
+}
