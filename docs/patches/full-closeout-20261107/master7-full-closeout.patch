+const dataKey=value=>value.replace(/^data-/,'').replace(/-([a-z])/g,(_,letter)=>letter.toUpperCase());
+class Element {
+ constructor(tag='div'){
+  this.tagName=tag.toUpperCase();this.children=[];this.dataset={};this.attributes={};this.listeners={};this.hidden=false;this.className='';this._text='';this._value='';
+  this.style={setProperty(){}};
+  this.classList={toggle:(name,active)=>{const classes=new Set(this.className.split(/\s+/).filter(Boolean));if(active)classes.add(name);else classes.delete(name);this.className=[...classes].join(' ');},contains:name=>this.className.split(/\s+/).includes(name)};
+ }
+ set textContent(value){this._text=String(value??'');this.children=[];}
+ get textContent(){return this._text+this.children.map(child=>child.textContent).join('');}
+ set value(value){this._value=String(value??'');}
+ get value(){return this._value;}
+ append(...children){for(const child of children){child.parentElement=this;this.children.push(child);}}
+ replaceChildren(...children){this.children=[];this._text='';this.append(...children);}
+ setAttribute(key,value){this.attributes[key]=String(value);}
+ addEventListener(name,callback){(this.listeners[name]??=[]).push(callback);}
+ querySelectorAll(selector){const result=[];for(const child of this.children){if(matches(child,selector))result.push(child);result.push(...child.querySelectorAll(selector));}return result;}
+ querySelector(selector){return this.querySelectorAll(selector)[0]??null;}
+ async dispatch(name){for(const callback of this.listeners[name]??[])await callback({preventDefault(){},currentTarget:this});}
+ get lastElementChild(){return this.children.at(-1);}
+}
+function matches(node,selector){
+ const data=selector.match(/^\[(data-[\w-]+)(?:="([^"]*)")?\]$/);
+ if(data){const key=dataKey(data[1]);return Object.hasOwn(node.dataset,key)&&(data[2]===undefined||node.dataset[key]===data[2]);}
+ return /^[a-z]+$/.test(selector)&&node.tagName===selector.toUpperCase();
+}
+function environment(file,{api,role='owner',periodAttribute,periods=[]}={}){
+ const nodes=new Map(),readyCallbacks=[];
+ const get=id=>{if(!nodes.has(id))nodes.set(id,new Element());return nodes.get(id);};
+ const buttons=periods.map(period=>{const button=new Element('button');button.dataset[periodAttribute]=period;return button;});
+ const document={readyState:'loading',getElementById:get,createElement:tag=>new Element(tag),addEventListener(name,callback){if(name==='DOMContentLoaded')readyCallbacks.push(callback);},querySelectorAll:selector=>buttons.filter(button=>matches(button,selector))};
