+import {postgresSql} from './render-sql.mjs';
+import {BACKUP_TABLES,type BackupReader} from './encrypted-backup.ts';
+
+type SnapshotClient={
+ query(sql:string,values?:unknown[]):Promise<{rows:unknown[];rowCount?:number|null}>;
+ release(destroy?:boolean):void|Promise<void>;
+};
+type SnapshotPool={connect():Promise<SnapshotClient>};
+type SnapshotStatement={bind(...values:unknown[]):SnapshotStatement;all():Promise<{results:unknown[]}>};
+
+// Only this acquired client participates in the snapshot. Ordinary requests
+// retain their normal pool path, and no session-wide settings are changed.
+export async function withPostgresReadSnapshot<T>(pool:SnapshotPool,read:(db:BackupReader)=>Promise<T>):Promise<T>{
+ const client=await pool.connect(),errors:unknown[]=[];
+ let active=false,discard=false,result:{value:T}|undefined;
+ const assertActive=()=>{if(!active)throw new Error('Backup read snapshot is closed');};
+ const assertBackupSelect=(sql:string)=>{
+  const match=sql.match(/^SELECT \* FROM ([a-z][a-z0-9_]*) ORDER BY [a-z][a-z0-9_]*(?:,[a-z][a-z0-9_]*)* LIMIT \? OFFSET \?$/);
+  if(!match||!(BACKUP_TABLES as readonly string[]).includes(match[1]))throw new Error('Backup read snapshot only accepts a single backup page SELECT');
+ };
+ const statement=(sql:string,values:unknown[]):SnapshotStatement=>({
+  bind(...next:unknown[]){return statement(sql,next);},
+  async all(){
+   assertActive();
+   const result=await client.query(postgresSql(sql),values);
+   assertActive();
+   return {results:result.rows};
+  },
