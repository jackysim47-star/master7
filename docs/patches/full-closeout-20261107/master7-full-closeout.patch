+import {readFileSync,readdirSync} from 'node:fs';
+import {handle} from '../lib/backend.ts';
+import {withdrawalWalletState} from '../lib/withdrawals.ts';
+
+// These requests exercise the real router and migrated database. The injected
+// gateway is a closed fixture; no test can contact a supplier or move real funds.
+const gateway='https://master7-integration-gateway.onrender.com';
+const gameToken='g'.repeat(48),walletToken='w'.repeat(48);
+const game={provider:'megah5',providerName:'MegaH5',gameCode:'55021',name:'Ocean Quest',category:'2',maintenance:false,playable:false};
+
+class Statement{
+ constructor(sqlite,sql,args=[]){this.sqlite=sqlite;this.sql=sql;this.args=args;}
+ bind(...args){return new Statement(this.sqlite,this.sql,args);}
+ async first(){return this.sqlite.prepare(this.sql).get(...this.args)??null;}
+ async all(){return {results:this.sqlite.prepare(this.sql).all(...this.args)};}
+ async run(){return this.sqlite.prepare(this.sql).run(...this.args);}
+}
+
+function harness(){
+ const sqlite=new DatabaseSync(':memory:');
+ const migrations=new URL('../drizzle/',import.meta.url);
+ for(const file of readdirSync(migrations).filter(name=>name.endsWith('.sql')).sort())sqlite.exec(readFileSync(new URL(file,migrations),'utf8'));
+ const db={prepare:sql=>new Statement(sqlite,sql),async batch(statements){sqlite.exec('BEGIN IMMEDIATE');try{const results=[];for(const statement of statements)results.push(await statement.run());sqlite.exec('COMMIT');return results;}catch(error){sqlite.exec('ROLLBACK');throw error;}}};
+ sqlite.prepare("INSERT INTO users(id,username,role,approved,csrf,created_at) VALUES('member','member@example.test','member',1,'fixture-csrf',0)").run();
