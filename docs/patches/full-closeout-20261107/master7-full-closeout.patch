+const stateGroup="CASE WHEN d.status='credited' THEN 'credited' WHEN d.status IN ('pending','creating','created','unknown') THEN 'pending' WHEN d.status='failed' THEN 'failed' WHEN d.status='review' THEN 'review' ELSE 'other' END";
