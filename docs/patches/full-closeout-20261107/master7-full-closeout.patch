+ {name:'Finance Center',file:'finance.js',exportName:'Master7Finance',periodAttribute:'financePeriod',status:'financeCenterStatus',summary:'financeCenterSummary',payload:value=>financeData(value==='LATEST_DAY'?'20000':'90000'),assertLatest:e=>assert.match(e.get('financeCenterSummary').textContent,/200\.00/),contentNodes:['financeCenterSummary','financeCenterSources','financeCenterReconciliation','financeCenterBank']},
+ {name:'Operations Intelligence',file:'operations-intelligence.js',exportName:'Master7OperationsIntelligence',periodAttribute:'opsPeriod',status:'operationsAiStatus',summary:'operationsAiSummary',payload:operationsData,assertLatest:e=>assert.match(e.get('operationsAiStatus').textContent,/LATEST_DAY/),contentNodes:['operationsAiSummary','operationsAiMetrics','operationsAiRecommendations']}
+];
+for(const report of reportCases){
+ test(`${report.name}: slow previous-period success cannot replace the latest period`,async()=>{
