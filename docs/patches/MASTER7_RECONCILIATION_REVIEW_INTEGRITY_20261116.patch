+test('Owner cannot acknowledge a report whose stored bytes no longer match its digest',async t=>{
+ const {sqlite,db}=fixture(t),run=await recordReconciliationRun(db,actor(),{input:input(),evidenceReference:'uat:vpay:statement-1'},100);
+ const payload={runId:run.runId,expectedRevision:0,decision:'acknowledged',note:'Owner checked the source references.',evidenceReference:'owner:review:integrity',requestKey:'review-integrity-0001'};
+ const stored=sqlite.prepare('SELECT report_json FROM reconciliation_runs WHERE run_id=?').get(run.runId).report_json;
+ sqlite.prepare('UPDATE reconciliation_runs SET report_json=? WHERE run_id=?').run(stored+' ',run.runId);
+ await assert.rejects(()=>recordReconciliationReview(db,actor(),payload,110),error=>error instanceof ReconciliationReviewError&&error.status===409&&error.code==='RECONCILIATION_INTEGRITY_ERROR');
+ assert.equal(sqlite.prepare('SELECT COUNT(*) n FROM reconciliation_review_events').get().n,0);
+ assert.equal(sqlite.prepare("SELECT COUNT(*) n FROM audit WHERE event='reconciliation_owner_review_recorded'").get().n,0);
+ assert.equal(sqlite.prepare('SELECT COUNT(*) n FROM wallet_ledger').get().n,0);
+});
+
