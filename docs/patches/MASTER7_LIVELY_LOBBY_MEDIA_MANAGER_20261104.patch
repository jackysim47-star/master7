+@keyframes casino-symbol { to { opacity: .9; filter: drop-shadow(0 0 8px currentColor); } }
+@media (max-width: 900px) {
+  .casino-hero-stage { display: none; }
+}
+@media (prefers-reduced-motion: reduce) {
