+.casino-hero-stage { position: relative; z-index: 1; display: grid; flex: 0 0 180px; place-items: center; min-height: 136px; margin: -12px 0; text-align: center; }
+.casino-hero-stage img { position: relative; z-index: 2; width: 105px; height: 105px; object-fit: contain; filter: drop-shadow(0 9px 20px #04030baa) drop-shadow(0 0 22px #407ce855); }
+.casino-hero-stage b { position: relative; z-index: 3; margin-top: -27px; color: #f4e4b1; font-size: 16px; letter-spacing: .14em; text-shadow: 0 2px 12px #000; }
+.casino-hero-stage small { position: relative; z-index: 3; color: #a7a5ce; font-size: 7px; letter-spacing: .22em; }
+.casino-symbols { position: absolute; inset: 0; }
