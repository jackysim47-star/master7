+.casino-symbols span:nth-child(1) { left: 7%; top: 12%; transform: rotate(-14deg); }
+.casino-symbols span:nth-child(2) { right: 7%; top: 18%; color: #e97f89; transform: rotate(13deg); }
+.casino-symbols span:nth-child(3) { left: 5%; bottom: 9%; color: #74d8bc; transform: rotate(12deg); }
