+test('VPay gateway maintenance preserves query and callback status without advertising new orders',async t=>{
+ const f=fixture(t);f.state.configPatch=value=>({...value,paymentReady:false,queryReady:true,callbacksReady:true});
+ const status=await f.call('/api/payments/vpay/status');assert.equal(status.status,200);
+ assert.equal(status.data.queryReady,true);assert.equal(status.data.callbacksReady,true);assert.equal(status.data.orderReady,false);
+ const health=await f.call('/health');assert.equal(health.data.providerOrdersEnabled.vpay,false);
+ const created=await f.create('vpay');assert.ok(created.status>=400);assert.equal(f.state.orders.vpay,0);
+});
+
+for(const capability of ['queryReady','callbacksReady'])test(`VPay explicit ${capability}=false cannot inherit legacy readiness`,async t=>{
+ const f=fixture(t);f.state.configPatch=value=>({...value,queryReady:true,callbacksReady:true,[capability]:false});
+ const status=await f.call('/api/payments/vpay/status');assert.equal(status.data[capability],false);assert.equal(status.data.orderReady,false);
+ const created=await f.create('vpay');assert.ok(created.status>=400);assert.equal(f.state.orders.vpay,0);
+});
+
+test('VPay partially upgraded capability replies fail closed without downgrading to the legacy contract',async t=>{
+ for(const patch of [{queryReady:true},{callbacksReady:true},{queryReady:'true',callbacksReady:true},{queryReady:true,callbacksReady:null}]){
+  const f=fixture(t);f.state.configPatch=value=>({...value,...patch});
+  const status=await f.call('/api/payments/vpay/status');assert.equal(status.data.orderReady,false);
+  const created=await f.create('vpay');assert.ok(created.status>=400);assert.equal(f.state.orders.vpay,0);
+ }
+});
+
