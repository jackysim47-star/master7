+/* Owner-confirmed screenshot theme. Visual arrangement only: existing routes,
+   controls, supplier IDs, wallet records and API behaviour stay intact. */
+:root {
+  color-scheme: dark;
+  --bg: #070a12;
+  --navy: #0a0f1d;
+  --panel: #0f1423;
+  --panel-2: #131a2b;
+  --line: #252d45;
+  --gold: #e2c477;
+  --aqua: #64d8bc;
+  --blue: #6a79f7;
+  --txt: #eef1f8;
+  --muted: #949fb5;
+  --red: #ef7e83;
+  --brand-gold-border: #4e477f;
+  --brand-gold-soft: #242442;
+  --brand-gold-strong: #b6a9ff;
+}
+body {
+  color: var(--txt);
+  background: radial-gradient(ellipse 70% 35% at 78% -8%, #242351 0, transparent 76%),
+              linear-gradient(180deg, #080b14 0%, #070a12 58%, #060810 100%);
+}
+.topbar, .portal-sidebar, .footer {
+  color: var(--muted); background: rgba(7,10,18,.97); border-color: #20273a;
+}
+.topbar { border-bottom-color: #252c42; box-shadow: 0 8px 30px #0005; }
+.brand, .footer-brand, .brand-mini, .lock-brand { color: var(--txt); }
+.brand small, .footer-brand small, .portal-sidebar-heading,
+.admin-sidebar-heading, .sidebar-foot { color: #78849b; }
+.brand-mini, .sidebar-icon { color: #b9adff; background: #181d31; border-color: #343d5d; }
+.lock-brand { width: 30px; height: 30px; min-width: 30px; border-radius: 8px; font-size: 13px; box-shadow: none; }
+.demo-ribbon { color: #d2c4a1; background: #15130f; border-color: #3c3426; }
+.nav-button, .sidebar-nav-button, .admin-internal-sidebar a { color: #a1abc0; }
+.nav-button:hover, .nav-button.active,
+.sidebar-nav-button:hover, .sidebar-nav-button.active,
+.admin-internal-sidebar a:hover, .admin-internal-sidebar a:focus-visible {
+  color: #f1f2fa; background: linear-gradient(100deg,#1a2038,#12182a); border-color: #343c60;
+}
+.sidebar-nav-button.active { box-shadow: inset 3px 0 #786df1; }
+.hero, #lobby > .section-header, .lobby-ad-carousel {
+  color: var(--txt); border-color: #343a68;
+  background: linear-gradient(112deg,#17224b 0%,#2c2458 50%,#10182f 100%);
+  box-shadow: 0 14px 38px #0006;
+}
+.hero-display { background: radial-gradient(ellipse,#26345d,transparent 70%); }
+.version-panel { background: #0b1020e8; border-color: #464e78; }
+.hero h1, #lobby > .section-header h1, .section-header h1,
+.section-header h2, .surface h2, .bonus-lobby-head h2,
+.provider-directory-heading h2, .game-card h3 { color: var(--txt); }
+.eyebrow, #lobby > .section-header .eyebrow { color: #9f9df4; }
+.provider-group-title, .hero h1 em, .version-panel b { color: #d8c88f; }
+.intro, .muted, .section-header p, #lobby > .section-header p,
+.feature p, .provider-card p, .game-card p, .surface label,
+.stack small, .row-item small, .stat span { color: var(--muted); }
+.feature, .surface, .admin-content .surface, .admin-content .ad-manager,
+.admin-content .benefit-manager, .admin-internal-sidebar, .ad-manager,
+.benefit-manager, .bonus-brand-lobby, .provider-directory-lobby,
+.api-supplier-lobby, .payment-lobby, .member-wallet, .deposit-guide,
+.deposit-guide-aside {
+  color: var(--txt); background: linear-gradient(145deg,#111727,#0c111e); border-color: var(--line);
+  box-shadow: 0 10px 28px #0002;
+}
+.stat, .provider-card, .provider-directory-card, .game-card, .mini-game-card,
+.bonus-brand-card, .bonus--jili, .bonus--megah5, .bonus--918kiss,
+.payment-option, .wallet-balance, .ticket, .wallet-record-row,
+.benefit-card, .guide-vendor, .api-supplier-button, .api-supplier-admin-button {
+  color: var(--txt); border-color: #2b334b;
+  background: linear-gradient(145deg,#171e31,#101522); box-shadow: none;
+}
+.stat { border-top: 1px solid #323b5a; }
+.stat strong, .wallet-balance strong { color: #f1f3fa; }
+.bonus-big-mark, .bonus-mark-jili, .bonus-mark-mega, .bonus-mark-kiss {
+  color: #d9d9ff; background: none; -webkit-text-fill-color: currentColor; text-shadow: 0 3px 18px #6870df55;
+}
+.bonus-brand-card:hover, .provider-directory-card:hover,
+.payment-option:hover, .api-supplier-button:hover { border-color: #696bd0; }
+.provider-directory-art { color: #d7d5ff; background: radial-gradient(circle at 45% 40%,#28335b,#0b101c); }
+.notice, .announcement, .ad-slot-spec, .benefit-scope-note,
+.wallet-status, .wallet-status-row { color: #aeb8cc; background: #111727; border-color: #293148; }
+.announcement p, .ticket p, .row-item { color: var(--txt); border-color: #252d43; }
+.announcement time, .ticket time { color: #7f8ba3; }
+.button-primary { color: #fff; background: linear-gradient(115deg,#516fe9,#7657df); border: 1px solid #7277ee; box-shadow: 0 7px 18px #302a6b55; }
+.button-outline, .button-ghost, .bonus-brand-action, .bonus-extra-action {
+  color: #d9def1; background: #171d2f; border-color: #3a4361; box-shadow: none;
+}
+.bonus-head-count, .bonus-locked, .bonus-index, .payment-number,
+.payment-lobby-counter, .tiny-label, .security-tag, .user-chip {
+  color: #b9afff; border-color: #494878; background: #1a1930;
+}
+.security-tag { padding: 4px 8px; font-size: 9px; letter-spacing: .06em; }
+.payment-hint, .payment-state, .provider-directory-label,
+.provider-directory-integration, .wallet-heading small { color: #929db3; }
+.game-category-chip { color: #a7b0c2; border-color: #30384f; background: #111624; }
+.game-category-chip.active { color: #f0efff; border-color: #6466bd; background: linear-gradient(110deg,#263367,#3a2c5b); }
+input, textarea, select, dialog select, .top-actions select,
+.filters input, .filters select, #lobby .filters input, #lobby .filters select {
+  color: #eff2f8; background: #0b101b; border-color: #303850;
+}
+input::placeholder, textarea::placeholder { color: #6f7b91; }
+input:focus, textarea:focus, select:focus { border-color: #7378df; box-shadow: 0 0 0 3px #6671db30; }
+dialog { color: var(--txt); background: linear-gradient(145deg,#141a2c,#0b101b); border-color: #3e4768; }
+dialog::backdrop { background: #02040ac7; }
+.close { color: #b9c1d1; background: #141a2b; border-color: #30384f; }
+#toast { color: #fff; background: #1a2442; border-color: #6571ce; }
+.footer { border-top-color: #242b3d; }
+:focus-visible { outline: 2px solid #7a80ea; outline-offset: 2px; }
+.api-supplier-art { background: #0b101b; }
+.api-supplier-admin-art { background: #f3f5f8; }
+.api-supplier-button.connected, .api-supplier-admin-button.connected {
+  border-color: #278c78; background: linear-gradient(145deg,#102b2b,#101823);
+}
+
+.admin-dashboard-heading, .admin-panel-heading {
+  display: flex; align-items: center; justify-content: space-between; gap: 18px;
+}
+.admin-dashboard-heading { padding: 4px 2px 2px; }
+.admin-dashboard-heading h2 { margin: 0; font-size: clamp(20px,2.3vw,28px); }
+.admin-dashboard-heading p { margin: 2px 0 0; }
+.admin-live-pill {
+  display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid #2e5a54;
+  border-radius: 999px; color: #72d9bd; background: #0e2423; font-size: 10px; font-weight: 800; letter-spacing: .08em;
+}
+.admin-live-pill span { width: 7px; height: 7px; border-radius: 50%; background: #52d3ae; box-shadow: 0 0 12px #52d3ae; }
+.admin-kpi-grid { grid-template-columns: repeat(3,minmax(0,1fr)); margin: 0; }
+.admin-kpi-grid .stat { position: relative; min-height: 94px; padding: 17px 18px; overflow: hidden; }
+.admin-kpi-grid .stat::after {
+  content: ""; position: absolute; right: 13px; top: 14px; width: 28px; height: 28px; border-radius: 8px;
+  background: #18253a; border: 1px solid #2c4058;
+}
+.admin-kpi-grid .stat:nth-child(3n+2)::after { background: #19223e; border-color: #333e69; }
+.admin-kpi-grid .stat:nth-child(3n)::after { background: #172c2c; border-color: #28514b; }
+.admin-kpi-grid .stat strong { font-size: clamp(22px,2.2vw,30px); line-height: 1.2; }
+.admin-kpi-grid .stat span { display: block; max-width: calc(100% - 34px); margin-top: 8px; font-size: 10px; text-transform: uppercase; letter-spacing: .05em; }
+.admin-panel-heading h2 { margin: 0; }
+.admin-panel-heading .eyebrow { margin: 0 0 3px; }
+.admin-trend-chart {
+  position: relative; min-height: 230px; overflow: hidden; border: 1px solid #242c40; border-radius: 10px;
+  background-color: #0b101c;
+  background-image: linear-gradient(#20283a55 1px,transparent 1px),linear-gradient(90deg,#20283a55 1px,transparent 1px);
+  background-size: 100% 25%, 12.5% 100%;
+}
+.trend-line { position: absolute; left: 0; right: 0; height: 1px; opacity: .35; }
+.trend-line-a { bottom: 18%; background: #52d3ae; }.trend-line-b { bottom: 17%; background: #ef6c7a; }
+.trend-line-c { bottom: 16%; background: #7784f4; }.trend-line-d { bottom: 15%; background: #d4bd70; }
+.admin-trend-empty { position: absolute; inset: 0; display: grid; place-items: center; color: #6f7b91; font-size: 11px; }
+
+@media (max-width: 760px) {
+  .admin-kpi-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
+  .admin-dashboard-heading { align-items: flex-start; }
+  .admin-dashboard-heading .muted { max-width: 250px; }
+  .admin-trend-chart { min-height: 180px; }
+}
+.portal-game-heading { margin-top: 16px; padding-top: 13px; border-top: 1px solid #20283a; }
+.sidebar-game-filter {
+  display: flex; align-items: center; gap: 9px; width: 100%; padding: 8px 10px; border: 1px solid transparent;
+  border-radius: 9px; color: #929db2; background: transparent; text-align: left; font-size: 11px; font-weight: 600;
+}
+.sidebar-game-filter:hover, .sidebar-game-filter.active { color: #f0f2f8; border-color: #303955; background: #151c2e; }
+.lobby-hero { align-items: center; }
+.lobby-live-summary { display: grid; grid-template-columns: repeat(3,minmax(72px,1fr)); gap: 7px; flex: 0 0 auto; }
+.lobby-live-summary span { min-width: 76px; padding: 10px 12px; border-left: 1px solid #ffffff1c; text-align: center; }
+.lobby-live-summary strong { display: block; color: #f4f5fb; font-size: 20px; line-height: 1.2; }
+.lobby-live-summary small { display: block; margin-top: 4px; color: #8b97ac; font-size: 8px; letter-spacing: .12em; }
+body.admin-mode #admin > .section-header { display: none; }
+
+@media (min-width: 1001px) {
+  body.admin-mode .portal-sidebar { display: none; }
+  body.admin-mode .page { width: auto; max-width: none; margin-left: 0; padding-left: max(22px,calc((100vw - 1440px)/2)); padding-right: max(22px,calc((100vw - 1440px)/2)); }
+  body.admin-mode .footer, body.admin-mode .public-social { margin-left: 0; }
+  body.admin-mode #admin { max-width: 1440px; }
+  body.admin-mode .admin-workspace { grid-template-columns: 214px minmax(0,1fr); gap: 16px; }
+  body.admin-mode .admin-internal-sidebar { top: 86px; min-height: calc(100vh - 112px); align-content: start; }
+}
+@media (max-width: 720px) {
+  .lobby-hero { align-items: flex-start; flex-direction: column; gap: 12px; }
+  .lobby-hero > div:first-child { width: 100%; }
+  .lobby-live-summary { width: 100%; grid-template-columns: repeat(3,1fr); }
+  .lobby-live-summary span { min-width: 0; padding: 10px 5px; border-top: 1px solid #ffffff14; }
+  .lobby-live-summary strong { font-size: 16px; }
+}
