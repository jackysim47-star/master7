+   if(this.sql.startsWith('INSERT INTO rate_limits(id,count,expires_at) VALUES(?,?,?)')){const [id,count,expiresAt,stamp]=this.args,current=leases.get(id);if(current&&current.expiresAt>stamp)return null;leases.set(id,{count,expiresAt});return {count};}
+   if(this.sql.startsWith('INSERT INTO rate_limits(id,count,expires_at) VALUES(?,1,?)')){const [id,expiresAt]=this.args,current=leases.get(id),count=(current?.count??0)+1;leases.set(id,{count,expiresAt});return {count};}
