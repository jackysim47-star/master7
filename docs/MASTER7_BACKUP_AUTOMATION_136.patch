+   throw Error('Unexpected all SQL: '+this.sql);
+  }
+  async run(){
+   if(this.sql==='INSERT INTO audit(id,user_id,event,target,created_at) VALUES(?,?,?,?,?)'){const [id,user_id,event,target,created_at]=this.args;audits.push({id,user_id,event,target,created_at});return {};}
