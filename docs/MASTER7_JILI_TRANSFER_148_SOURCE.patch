+/** Constructing an adapter does not activate a profile or certify a supplier
+ * account. Cash methods additionally require its verified merchant contract. */
+export function createJiliGameProviderAdapter(config:JiliConfig,options:JiliAdapterOptions):GameProviderAdapter&{readonly profileId:JiliProfile}{
