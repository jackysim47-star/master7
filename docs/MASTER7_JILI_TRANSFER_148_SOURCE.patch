+import {createHash,randomBytes} from 'node:crypto';
+import {gameAmountToWalletMinor,walletMinorToGameAmount} from './game-unit-conversion.ts';
+
+// Legacy transfer-wallet protocol, isolated from platform ledger writes.
+// Unit choices must come from this merchant's accepted account contract.
+export type JiliProfile='jili_myr_1to1'|'jili_my1_1to100';
+export type JiliAmountUnit='platform_currency'|'game_points';
+export type JiliConfig={
+ profile:JiliProfile;baseUrl:string;agentId:string;agentKey:string;
+ transferAmountUnit:JiliAmountUnit;queryAmountUnit:JiliAmountUnit;
+ balanceAmountUnit:JiliAmountUnit;reportAmountUnit:JiliAmountUnit;
+ launchOrigins:readonly string[];
+};
+export type JiliTransfer={playerId:string;transactionId:string;direction:'deposit'|'withdrawal';amountMinor?:string;providerTransactionId?:string};
+export type JiliReceipt={state:'confirmed'|'rejected'|'unknown';providerTransactionId?:string;amountMinor?:string;errorCode?:string;requiresLedgerReconciliation:true};
+export class JiliProtocolError extends Error{readonly code:string;constructor(code:string){super(code);this.name='JiliProtocolError';this.code=code;}}
+const fail=(code:string):never=>{throw new JiliProtocolError(code);};
+const md5=(text:string)=>createHash('md5').update(text,'utf8').digest('hex');
+const object=(v:unknown):v is Record<string,unknown>=>!!v&&typeof v==='object'&&!Array.isArray(v);
+const safeText=(v:unknown,re:RegExp,code='JILI_INPUT_INVALID')=>typeof v==='string'&&re.test(v)?v:fail(code);
+const member=(v:unknown)=>safeText(v,/^[A-Za-z0-9_]{1,32}$/);
+const serial=(v:unknown)=>safeText(v,/^[A-Za-z0-9]{1,50}$/);
+const integer=(v:unknown,max=1_000_000)=>typeof v==='string'&&/^(0|[1-9]\d{0,9})$/.test(v)&&Number(v)<=max?Number(v):fail('JILI_RESPONSE_INVALID');
+const decimal=(v:unknown)=>typeof v==='string'&&/^(0|[1-9]\d{0,11})(?:\.\d{1,4})?$/.test(v)?v:fail('JILI_AMOUNT_INVALID');
+const units=(v:unknown):v is JiliAmountUnit=>v==='platform_currency'||v==='game_points';
+const unknown=(code='JILI_TRANSFER_UNKNOWN'):JiliReceipt=>({state:'unknown',errorCode:code,requiresLedgerReconciliation:true});
+function origin(raw:string){
+ try{const u=new URL(raw);if(u.origin!==raw||u.protocol!=='https:'||u.username||u.password||u.port) return fail('JILI_ORIGIN_INVALID');return u.origin;}catch{return fail('JILI_ORIGIN_INVALID');}
+}
+export function jiliDate(epoch:number){
+ if(!Number.isSafeInteger(epoch)||epoch<=0)return fail('JILI_CLOCK_INVALID');
+ const d=new Date(epoch-4*60*60_000);return `${String(d.getUTCFullYear()).slice(-2)}${String(d.getUTCMonth()+1).padStart(2,'0')}${d.getUTCDate()}`;
+}
+export function jiliSignature(query:string,agentId:string,agentKey:string,epoch:number,prefix=randomBytes(3).toString('hex'),suffix=randomBytes(3).toString('hex')){
+ safeText(prefix,/^[A-Za-z0-9]{6}$/);safeText(suffix,/^[A-Za-z0-9]{6}$/);
+ return prefix+md5(query+md5(jiliDate(epoch)+agentId+agentKey))+suffix;
+}
+export function jiliPlayerId(profile:JiliProfile,userId:string){
+ if(!['jili_myr_1to1','jili_my1_1to100'].includes(profile))return fail('JILI_PROFILE_INVALID');
+ safeText(userId,/^[A-Za-z0-9_.:-]{1,200}$/);return 'm7'+createHash('sha256').update(`${profile}\0${userId}`).digest('hex').slice(0,28);
+}
+export function jiliTransactionId(profile:JiliProfile,reference:string,direction:'deposit'|'withdrawal'){
+ if(!['jili_myr_1to1','jili_my1_1to100'].includes(profile)||!['deposit','withdrawal'].includes(direction))return fail('JILI_PROFILE_INVALID');
+ safeText(reference,/^[A-Za-z0-9_.:-]{1,200}$/);return 'm7'+createHash('sha256').update(`${profile}\0${direction}\0${reference}`).digest('hex').slice(0,44);
