+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {createJiliProtocolClient,jiliDate,jiliSignature,jiliPlayerId,jiliTransactionId} from '../lib/jili-transfer-protocol.ts';
+import {createJiliGameProviderAdapter} from '../lib/jili-provider-adapter.ts';
+import {jiliProfileRuntime} from '../lib/jili-profile-runtime.ts';
+import {getGameProviderProfile} from '../lib/game-provider-registry.ts';
+import {gameTransferRuntime} from '../lib/game-provider-runtime.ts';
+
+const time=Date.parse('2026-11-10T12:00:00Z'),hash=s=>createHash('md5').update(s).digest('hex');
+const cfg=(profile='jili_myr_1to1')=>({profile,baseUrl:'https://supplier.example.test/api1',agentId:'synthetic_myr',agentKey:'syntheticKey000000000000000000000',transferAmountUnit:'platform_currency',queryAmountUnit:'platform_currency',balanceAmountUnit:'game_points',reportAmountUnit:'game_points',launchOrigins:['https://games.example.test']});
+function fake(handlers,config=cfg()){
+ const calls=[],transport=async(url,init)=>{
+  const u=new URL(url),method=u.pathname.split('/').at(-1),body=new URLSearchParams(init.body);calls.push({method,body});assert.equal(u.origin,new URL(config.baseUrl).origin);assert.equal(init.redirect,'error');assert.equal(init.method,'POST');
+  const excluded=new Set(['Key',...(method==='LoginWithoutRedirect'?['HomeUrl','platform','disableFullScreen']:[])]),query=[...body].filter(([k])=>!excluded.has(k)).map(([k,v])=>`${k}=${v}`).join('&');
+  assert.equal(body.get('Key').slice(6,-6),hash(query+hash(jiliDate(time)+config.agentId+config.agentKey)));assert.equal([...body].filter(([k])=>!excluded.has(k)).at(-1)[0],'AgentId');
+  const value=handlers[method];if(!value)throw Error('Unexpected method '+method);return typeof value==='function'?value(body):Response.json(value);
+ };
+ return{calls,transport,client:createJiliProtocolClient(config,transport,()=>time)};
+}
+const success=data=>({ErrorCode:0,Message:'success',Data:data});
+const input={playerId:'m7synthetic',transactionId:'m7original',direction:'deposit',amountMinor:'2000'};
+const receipt=(overrides={})=>success({Account:input.playerId,TransactionId:input.transactionId,Amount:20,TransferType:2,Status:1,...overrides});
+
+test('JILI signing matches the published example and the UTC-4 unpadded day boundary',()=>{
+ const epoch=Date.parse('2019-01-01T16:00:00Z'),query='Account=Test006&GameId=1&Lang=zh-CN&AgentId=abcd_RMB';
+ assert.equal(jiliSignature(query,'abcd_RMB','be8e08f95357d215921f91c6a533f74d3194de52',epoch,'123456','abcdef'),'123456589437f4a0382062dfd0fa5b76eca799abcdef');
+ assert.equal(jiliDate(Date.parse('2026-02-07T03:59:59Z')),'26026');assert.equal(jiliDate(Date.parse('2026-02-07T04:00:00Z')),'26027');
+ assert.notEqual(jiliPlayerId('jili_myr_1to1','alice'),jiliPlayerId('jili_my1_1to100','alice'));assert.notEqual(jiliTransactionId('jili_myr_1to1','same','deposit'),jiliTransactionId('jili_myr_1to1','same','withdrawal'));
+});
+test('JILI game catalogue preserves escaped names and rejects duplicate game IDs',async()=>{
+ const row={GameId:1,name:{'en-US':'A "quoted" game 123'},GameCategoryId:1},f=fake({GetGameList:success([row])});assert.equal((await f.client.listGames())[0].name,row.name['en-US']);
+ const bad=fake({GetGameList:success([row,row])});await assert.rejects(()=>bad.client.listGames(),e=>e.code==='JILI_RESPONSE_INVALID');
+});
+test('deposit confirmation requires the original account, direction, amount and transaction query',async()=>{
+ const f=fake({ExchangeTransferByAgentId:success({TransactionId:input.transactionId,Status:1}),CheckTransferByTransactionId:receipt()});
+ assert.deepEqual(await f.client.transfer(input),{state:'confirmed',providerTransactionId:input.transactionId,amountMinor:'2000',requiresLedgerReconciliation:true});
+ assert.deepEqual(f.calls.map(x=>x.method),['ExchangeTransferByAgentId','CheckTransferByTransactionId']);assert.equal(f.calls[0].body.get('Amount'),'20.00');
+ for(const patch of [{Account:'other'},{TransactionId:'other'},{TransferType:1},{Amount:19.99},{Status:2}]){
+  const b=fake({CheckTransferByTransactionId:receipt(patch)});assert.equal((await b.client.queryTransfer(input)).state,'unknown');
+ }
+});
+test('sweeps ignore a delayed member balance and record the actual zero or positive transfer',async()=>{
+ for(const amount of [0,15.75]){
+  const transfer={...input,direction:'withdrawal'};delete transfer.amountMinor;
+  const f=fake({ExchangeTransferByAgentId:success({TransactionId:input.transactionId,Status:1}),CheckTransferByTransactionId:receipt({TransferType:1,Amount:amount})});
+  const result=await f.client.transfer(transfer);assert.equal(result.state,'confirmed');assert.equal(result.amountMinor,amount===0?'0':'1575');assert.equal(result.providerTransactionId,input.transactionId);assert.equal(f.calls[0].body.get('TransferType'),'1');assert.equal(f.calls[0].body.get('Amount'),'0');assert.ok(f.calls.every(x=>x.method!=='GetMemberInfo'));
+ }
+});
