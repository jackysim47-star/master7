+const success=result=>({ok:true,status:200,description:'Success',responseDateTime:'2026-11-10 09:00:00',...result});
+function fake(profile='metagaming_normal_myr',overrides={}){
+ const cfg=config(profile),calls=[],handlers={player:success({}),launch:success({url:'https://games.example.test/play?session=synthetic'}),balance:success({currentBalance:'15.75',currency:'MYR'}),deposit:success({currentBalance:'20.00',currency:'MYR'}),withdraw:success({currentBalance:'0.00',currency:'MYR'}),'transfer-status':success({transaction:{transactionId:'123456',amount:'20.00',previousBalance:'0',newBalance:'20.00'}}),kick:success({kickAccepted:true,closureFinal:false}),'unfinished-rounds':success({rounds:[]}),reports:success({logs:[]}),...overrides},expected={player:tokens.player,launch:tokens.player,balance:tokens.player,deposit:tokens.wallet,withdraw:tokens.wallet,'transfer-status':tokens.wallet,kick:tokens.recovery,'unfinished-rounds':tokens.recovery,reports:tokens.report,'flag-log':tokens.report};
