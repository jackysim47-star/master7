+/** Server-side gateway adapter only. Constructing it does not enable a profile,
+ * submit money, establish session finality, or record supplier acceptance. */
+export function createMetaGamingProviderAdapter(config:MetaGamingGatewayConfig,options:MetaGamingAdapterOptions):GameProviderAdapter&{readonly profileId:MetaGamingProfile;readonly account:MetaGamingAccount}{
+ if(!config||!options||!Array.isArray(config.launchOrigins)||!Array.isArray(options.allowedReturnOrigins))return fail('META_CONFIGURATION_INVALID');
+ const profileId=config.profile,account=profileAccount(profileId);
