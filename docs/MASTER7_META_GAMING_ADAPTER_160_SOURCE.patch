+   if(input.language!=='en')return fail('META_LANGUAGE_UNCONFIRMED');let returnUrl:URL;try{returnUrl=new URL(input.returnUrl);}catch{return fail('META_RETURN_URL_INVALID');}
+   if(!returns.has(returnUrl.origin)||returnUrl.protocol!=='https:'||returnUrl.username||returnUrl.password||returnUrl.hash||returnUrl.href.length>100)return fail('META_RETURN_URL_INVALID');
