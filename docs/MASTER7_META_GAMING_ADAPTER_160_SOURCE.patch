+   const items:GameProviderWager[]=logs.map(row=>{if(!isObject(row))return fail('META_REPORT_INVALID');const id=String(row.transactionId??'');if(!/^[1-9]\d{0,30}$/.test(id)||seen.has(id))return fail('META_REPORT_INVALID');seen.add(id);const playerId=cleanText(row.playerId,account==='normal'?/^m7mn_[a-f0-9]{45}$/:/^m7mf_[a-f0-9]{45}$/,'META_REPORT_PROFILE_MISMATCH'),bet=cents(row.turnover),win=cents(row.payout),settledAt=isoUtc(row.transactionDateTime);return{providerRoundId:null,providerBetId:id,providerPlayerId:playerId,providerGameId:cleanText(row.gameCode,/^[^\u0000-\u001f\u007f]{1,50}$/u,'META_REPORT_INVALID'),betMinor:bet.amountMinor,winMinor:win.amountMinor,currency:'MYR',settledAt,sourceDetails:Object.freeze({validTurnover:String(row.validTurnover??''),winLose:String(row.winLose??''),transactionType:String(row.transactionType??''),gameType:String(row.gameType??''),gameName:String(row.gameName??''),flagging:'not_performed'})};});
