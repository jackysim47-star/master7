+  const p=c?.profile,expectedClass=account==='free'?'free_credit':'cash';
+  if(!p||p.profileId!==profileId||p.providerId!=='metagaming'||p.adapterKey!=='metagaming'||p.walletMode!=='transfer'||p.currency!=='MYR'||p.unitScale!==1||p.balanceClass!==expectedClass||p.playerNamespace!==profileId||p.ledgerNamespace!==profileId)return fail('META_PROFILE_MISMATCH');
+ }
+ function boundPlayer(userId:unknown,supplied:unknown){const expected=metaGamingPlayerId(profileId,member(userId));if(supplied!==expected)return fail('META_PLAYER_MISMATCH');return expected;}
+ function cashGate(enabled:boolean,code:string){if(!flags.contract||!flags.closure)return fail('META_MERCHANT_CONTRACT_UNVERIFIED');if(!enabled)return fail(code);}
+ async function call(method:string,credential:string,fields:Record<string,unknown>={}){
+  const response=await transport(`${baseUrl}/platform/metagaming/${method}`,{method:'POST',redirect:'error',headers:{Accept:'application/json','Content-Type':'application/json',Authorization:`Bearer ${credential}`},body:JSON.stringify({profileId,account,...fields})});
+  const raw=await response.text(),value=readJson(raw);if(!response.ok)return fail(response.status===503?'META_CAPABILITY_DISABLED':response.status===401?'META_GATEWAY_UNAUTHORIZED':'META_GATEWAY_REQUEST_FAILED');return resultEnvelope(value,profileId,account,method);
+ }
+ async function catalogue():Promise<readonly GameProviderGame[]>{
+  const response=await transport(`${baseUrl}/providers/metagaming/games?account=${account}`,{method:'GET',redirect:'error',headers:{Accept:'application/json'}}),value=readJson(await response.text());
+  if(!response.ok||value.provider!=='metagaming'||value.account!==account||value.currency!=='MYR'||!Array.isArray(value.games)||value.games.length>2000)return fail('META_CATALOGUE_UNAVAILABLE');
+  const seen=new Set<string>();return value.games.map(row=>{if(!isObject(row))return fail('META_CATALOGUE_INVALID');const id=cleanText(row.gameCode,/^[^\u0000-\u001f\u007f]{1,50}$/u,'META_CATALOGUE_INVALID'),name=cleanText(row.name,/^[^\u0000-\u001f\u007f]{1,200}$/u,'META_CATALOGUE_INVALID');if(seen.has(id))return fail('META_CATALOGUE_INVALID');seen.add(id);return{providerGameId:id,name,category:String(row.gameType??''),maintenance:row.maintenance!==false};});
+ }
+ function transferInput(input:GameProviderTransferInput,direction:'deposit'|'withdrawal'){
+  if(!input||input.currency!=='MYR'||typeof input.amountMinor!=='string'||!/^[1-9]\d{0,15}$/.test(input.amountMinor))return fail('META_TRANSFER_INPUT_INVALID');
+  return{playerId:boundPlayer(input.userId,input.providerPlayerId),referenceId:metaGamingReferenceId(profileId,input.platformTransactionId,direction),amount:walletMinorToGameAmount(input.amountMinor,1),amountMinor:input.amountMinor};
+ }
+ async function transfer(c:GameProviderContext,input:GameProviderTransferInput,direction:'deposit'|'withdrawal'):Promise<GameProviderTransferResult>{
+  context(c);const value=transferInput(input,direction);cashGate(direction==='deposit'?flags.deposit:flags.withdrawal,`META_${direction.toUpperCase()}_DISABLED`);
