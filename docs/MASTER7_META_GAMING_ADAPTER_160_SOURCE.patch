+  },
+  async fetchWagers(c,cursor){
+   context(c);if(!flags.report)return fail('META_REPORT_DISABLED');if(!cursor||cursor.cursor!==undefined||!Number.isSafeInteger(cursor.from)||!Number.isSafeInteger(cursor.to)||cursor.from<0||cursor.to<=cursor.from)return fail('META_REPORT_WINDOW_INVALID');
