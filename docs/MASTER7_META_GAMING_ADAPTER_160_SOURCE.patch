+   if(typeof result.url!=='string'||result.url.length>2000)return fail('META_LAUNCH_URL_INVALID');let url:URL;try{url=new URL(result.url);}catch{return fail('META_LAUNCH_URL_INVALID');}if(url.protocol!=='https:'||url.username||url.password||url.hash||!launchOrigins.has(url.origin))return fail('META_LAUNCH_URL_INVALID');return{launchUrl:url.href};
+  },
+  async queryTransfer(c,input){
+   context(c);const direction=input?.direction;if(direction!=='deposit'&&direction!=='withdrawal')return fail('META_TRANSFER_INPUT_INVALID');const value=transferInput(input,direction);cashGate(flags.status,'META_TRANSFER_STATUS_DISABLED');
+   const result=await call('transfer-status',tokens[1],{playerId:value.playerId,referenceId:value.referenceId,transferType:direction}),transaction=result.transaction;if(!isObject(transaction))return{state:'unknown',errorCode:'META_TRANSFER_STATUS_UNCONFIRMED',requiresLedgerReconciliation:true};
+   const amount=cents(transaction.amount),providerTransactionId=String(transaction.transactionId??'');if(amount.amountMinor!==value.amountMinor||amount.residual||!/^[1-9]\d{0,30}$/.test(providerTransactionId)||(input.providerTransactionId!==undefined&&input.providerTransactionId!==providerTransactionId))return{state:'unknown',errorCode:'META_TRANSFER_RECEIPT_MISMATCH',requiresLedgerReconciliation:true};
+   return{state:'confirmed',providerTransactionId,requiresLedgerReconciliation:true};
+  },
+  async closeGame(c,input){
+   context(c);const playerId=boundPlayer(input.userId,input.providerPlayerId);if(!flags.closure)return fail('META_SESSION_CLOSURE_UNVERIFIED');
