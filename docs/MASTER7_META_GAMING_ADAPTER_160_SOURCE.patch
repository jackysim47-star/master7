+  player:options.playerCreationEnabled===true,balance:options.balanceEnabled===true,
+  deposit:options.depositEnabled===true,withdrawal:options.withdrawalEnabled===true,
+  launch:options.launchEnabled===true,status:options.transferStatusEnabled===true,
+  recovery:options.recoveryEnabled===true,report:options.reportEnabled===true,
+ });
+ const transport=options.fetchImpl;
