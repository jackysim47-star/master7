+  'profile.settlement_currency',
+  'profile.amount_unit',
+  'profile.amount_precision',
+  'profile.conversion_ratio',
+] as const);
+
+function readPath(input: unknown, path: string): unknown {
+  let current: unknown = input;
+  for (const segment of path.split('.')) {
+    if (!current || typeof current !== 'object' || Array.isArray(current)) return undefined;
+    current = (current as Record<string, unknown>)[segment];
+  }
+  return current;
+}
+
+function documented(value: unknown): boolean {
+  if (typeof value === 'string') return value.trim().length > 0;
+  if (Array.isArray(value)) return value.length > 0 && value.every(item => typeof item === 'string' && item.trim().length > 0);
+  return Number.isSafeInteger(value) && Number(value) >= 0;
+}
+
+export type Coba8ContractDiagnostic = Readonly<{
+  profileId: typeof COBA8_PROFILE_ID;
+  manifestComplete: boolean;
+  missingContractFields: readonly string[];
+  documentationOnly: true;
+  credentialsPresent: boolean;
+  adapterImplemented: false;
+  catalogueAllowed: false;
+  launchAllowed: false;
+  walletAllowed: false;
+  settlementAllowed: false;
+  recoveryAllowed: false;
+  playAllowed: false;
+}>;
+
+/**
+ * This validator reports documentation gaps only. Credential-shaped input is
+ * intentionally ignored: a login, password or API token is not an API contract
+ * and can never enable a catalogue, adapter, wallet or Play button.
+ */
+export function inspectCoba8ContractManifest(manifest: unknown = {}): Coba8ContractDiagnostic {
+  const missingContractFields = COBA8_REQUIRED_CONTRACT_FIELDS.filter(path => !documented(readPath(manifest, path)));
+  const record = manifest && typeof manifest === 'object' && !Array.isArray(manifest) ? manifest as Record<string, unknown> : {};
+  const credentialsPresent = ['apiToken', 'api_key', 'token', 'username', 'password', 'merchantId']
+    .some(key => typeof record[key] === 'string' && String(record[key]).trim().length > 0);
+  return Object.freeze({
+    profileId: COBA8_PROFILE_ID,
+    manifestComplete: missingContractFields.length === 0,
+    missingContractFields: Object.freeze([...missingContractFields]),
+    documentationOnly: true,
+    credentialsPresent,
+    adapterImplemented: false,
+    catalogueAllowed: false,
+    launchAllowed: false,
+    walletAllowed: false,
+    settlementAllowed: false,
+    recoveryAllowed: false,
+    playAllowed: false,
+  });
+}
