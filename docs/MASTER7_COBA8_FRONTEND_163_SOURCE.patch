+export const COBA8_PROFILE_ID = 'coba8_myr' as const;
+
+/**
+ * Field names describe the evidence needed from the supplier. They never hold
+ * credential values and are safe to expose in an internal readiness report.
+ */
+export const COBA8_REQUIRED_CONTRACT_FIELDS = Object.freeze([
+  'document.document_id',
+  'document.api_version',
+  'document.environment',
