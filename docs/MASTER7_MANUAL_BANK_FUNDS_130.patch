+ if(typeof value!=='string'||value.trim().length>100||!/^[A-Za-z0-9][A-Za-z0-9 /_.:-]{3,99}$/.test(value.trim()))return null;
+ const original=value.trim(),normalized=original.toUpperCase().replace(/[\s-]/g,'');
+ return normalized.length>=4?{original,normalized}:null;
+};
+export function bankImage(value:unknown){
+ if(typeof value!=='string'||value.length>500000||!/^data:image\/(?:jpeg|png|webp);base64,[A-Za-z0-9+/]+={0,2}$/.test(value))return null;
+ try{const raw=atob(value.slice(value.indexOf(',')+1)),b=[...raw.slice(0,12)].map(x=>x.charCodeAt(0));
