+import assert from 'node:assert/strict';
+import {walletMinorToGameAmount,gameAmountToWalletMinor} from '../lib/game-unit-conversion.ts';
+import {getGameProviderProfile} from '../lib/game-provider-registry.ts';
+
+test('918KISS H5 and JILI 1:100 profiles convert points back to MYR, independently of 1:1 entries',()=>{
+ for(const id of ['918kiss_normal_my1_1to100','jili_my1_1to100']){const p=getGameProviderProfile(id);assert.equal(p.unitScale,100);assert.equal(walletMinorToGameAmount('100',p.unitScale),'100.00');assert.equal(walletMinorToGameAmount('12345',p.unitScale),'12345.00');const back=gameAmountToWalletMinor('12345',p.unitScale);assert.equal(back.amountMinor,'12345');assert.equal(back.residual,false);assert.equal(back.currency,'MYR');}
+ for(const id of ['918kiss_normal_myr','jili_myr_1to1']){const p=getGameProviderProfile(id);assert.equal(p.unitScale,1);assert.equal(walletMinorToGameAmount('100',p.unitScale),'1.00');assert.equal(gameAmountToWalletMinor('100',p.unitScale).amountMinor,'10000');}
+});
+test('a 1:100 account returns 50 points as MYR 0.50 and does not multiply the member ledger',()=>{assert.equal(gameAmountToWalletMinor('50.00',100).amountMinor,'50');assert.equal(gameAmountToWalletMinor('100.00',100).amountMinor,'100');assert.equal(gameAmountToWalletMinor('10000.00',100).amountMinor,'10000');assert.equal(walletMinorToGameAmount('1',100),'1.00');});
+test('fractional-sen provider remainders remain explicit and are never silently rounded',()=>{const a=gameAmountToWalletMinor('100.5',100);assert.equal(a.amountMinor,'100');assert.equal(a.residual,true);assert.equal(a.providerAmount,'100.5');assert.equal(a.residualMinorNumerator,'500');assert.equal(a.residualMinorDenominator,'1000');const b=gameAmountToWalletMinor('0.001',1);assert.equal(b.amountMinor,'0');assert.equal(b.residual,true);});
+test('conversion round-trips integers without binary floating point for both supported ratios',()=>{for(const rate of [1,100])for(const cents of ['0','1','99','100','12345','99999999999','9007199254740993','9223372036854775807']){const game=walletMinorToGameAmount(cents,rate),cash=gameAmountToWalletMinor(game,rate);assert.equal(cash.amountMinor,cents);assert.equal(cash.residual,false);}});
