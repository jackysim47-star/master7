+  o.session_id IS NULL OR p.id IS NULL OR player.user_id IS NULL
+  OR o.profile_id<>s.profile_id OR o.user_id<>s.user_id OR p.provider_id<>s.provider
+  OR player.provider_player_id<>s.player_id OR player.status<>'verified'
+  OR p.wallet_mode<>'transfer' OR p.balance_class<>'cash' OR p.currency<>'MYR' OR p.unit_numerator<>p.unit_denominator
+  OR (s.status IN ('deposit_pending','deposit_unknown','active','withdraw_pending','withdraw_unknown','manual_review') AND (r.user_id IS NULL OR r.user_id<>s.user_id OR r.amount_minor<>s.amount_out_minor))
+  OR (s.status IN ('settled','deposit_failed') AND r.user_id IS NOT NULL)
+  OR (o.deposit_state='prepared' AND o.deposit_attempts<>0)
+  OR (o.deposit_state IN ('submitting','unknown','confirmed') AND o.deposit_attempts<>1)
+  OR (o.deposit_state='confirmed' AND (o.deposit_provider_reference IS NULL OR LENGTH(o.deposit_provider_reference)<1))
+  OR (o.withdrawal_state IN ('submitting','unknown') AND o.withdrawal_attempts<>1)
+  OR s.status='manual_review' OR o.deposit_state='review' OR o.withdrawal_state='review'
+  OR (s.status IN ('active','withdraw_pending','withdraw_unknown','settled') AND o.deposit_state<>'confirmed')
+  OR (s.status='deposit_unknown' AND o.deposit_state<>'unknown')
+  OR (s.status='deposit_failed' AND NOT (o.deposit_state='rejected' AND o.withdrawal_state='none' AND NOT EXISTS(SELECT 1 FROM game_wallet_ledger l WHERE l.session_id=s.id)))
