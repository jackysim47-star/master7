+const DEFAULT_POOL_MAX = 5;
+const MAX_POOL_PER_INSTANCE = 5;
+
+export function postgresPoolMax(value) {
+  if (value === undefined || value === null || value === "") return DEFAULT_POOL_MAX;
+  const parsed = Number(value);
+  return Number.isSafeInteger(parsed) && parsed >= 1 && parsed <= MAX_POOL_PER_INSTANCE
+    ? parsed
+    : DEFAULT_POOL_MAX;
+}
+
+export function postgresPoolRuntimeOptions(environment = process.env) {
+  return {
+    max: postgresPoolMax(environment.PG_POOL_MAX),
+    idleTimeoutMillis: 30_000,
+    connectionTimeoutMillis: 10_000,
+    maxLifetimeSeconds: 300,
+    keepAlive: true,
+    keepAliveInitialDelayMillis: 10_000,
+  };
+}
+
+export function registerPostgresPoolErrorHandler(pool, logger = console.error) {
+  pool.on("error", error => {
+    const code = typeof error?.code === "string" && /^[A-Z0-9_]{1,32}$/.test(error.code)
+      ? error.code
+      : "UNKNOWN";
+    logger(`MASTER7 PostgreSQL idle connection error; pool will replace the connection (${code}).`);
+  });
+  return pool;
+}
