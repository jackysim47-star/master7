+
+const PROFILE_EXPECTATIONS: Readonly<Record<KissH5ProfileId, Readonly<Record<string, readonly string[]>>>> = Object.freeze({
+  '918kiss_normal_myr': Object.freeze({
+    'profile.profile_id': ['918kiss_normal_myr'],
+    'profile.account_variant': ['normal'],
+    'profile.provider_currency': ['MYR'],
+    'profile.settlement_currency': ['MYR'],
+    'profile.balance_class': ['cash'],
+  }),
