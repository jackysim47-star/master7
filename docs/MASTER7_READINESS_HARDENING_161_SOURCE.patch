+  if (requirement.kind === 'sha256') return typeof value === 'string' && /^[a-f0-9]{64}$/.test(value) ? null : 'invalid_sha256';
+  if (requirement.kind === 'ratio') return typeof value === 'string' && /^[1-9]\d{0,8}:[1-9]\d{0,8}$/.test(value) ? null : 'invalid_ratio';
+  return 'invalid_value';
+}
+
+export function getKissH5ContractRequirements(profileId: string): readonly KissH5ContractRequirement[] {
+  if (!isProfileId(profileId)) return Object.freeze([]);
+  return Object.freeze([...KISS_H5_COMMON_VENDOR_FIELDS, ...PROFILE_FIELDS[profileId]]);
+}
+
+export type KissH5ContractDiagnostic = Readonly<{
+  profileId: string;
+  knownProfile: boolean;
+  manifestComplete: boolean;
+  missingVendorFields: readonly string[];
+  invalidVendorFields: readonly Readonly<{field: string; reason: string}>[];
+  documentationOnly: true;
+  adapterImplemented: false;
+  launchAllowed: false;
+  walletAllowed: false;
+  playAllowed: false;
+}>;
+
+/**
+ * Performs syntax and scope validation only. A complete manifest still cannot
+ * enable an adapter, wallet movement, game launch or Play button. Supplier
+ * documents must be reviewed and an independently tested adapter implemented.
+ */
+export function inspectKissH5ContractManifest(profileId: string, manifest: unknown = {}): KissH5ContractDiagnostic {
+  const knownProfile = isProfileId(profileId);
+  const requirements = getKissH5ContractRequirements(profileId);
+  const missingVendorFields: string[] = [];
+  const invalidVendorFields: Array<{field: string; reason: string}> = [];
+  if (knownProfile) {
+    for (const requirement of requirements) {
+      const value = readPath(manifest, requirement.field);
+      if (value === undefined || value === null || value === '') {
+        missingVendorFields.push(requirement.field);
+        continue;
+      }
+      const reason = validateValue(value, requirement, PROFILE_EXPECTATIONS[profileId][requirement.field]);
+      if (reason) invalidVendorFields.push({field: requirement.field, reason});
+    }
+  }
+  return Object.freeze({
+    profileId,
+    knownProfile,
+    manifestComplete: knownProfile && missingVendorFields.length === 0 && invalidVendorFields.length === 0,
+    missingVendorFields: Object.freeze(missingVendorFields),
+    invalidVendorFields: Object.freeze(invalidVendorFields.map(item => Object.freeze(item))),
+    documentationOnly: true,
+    adapterImplemented: false,
+    launchAllowed: false,
+    walletAllowed: false,
+    playAllowed: false,
+  });
+}
