+    'profile.account_variant': ['my1'],
+    'profile.balance_class': ['cash'],
+  }),
+  '918kiss_free_myr': Object.freeze({
+    'profile.profile_id': ['918kiss_free_myr'],
+    'profile.account_variant': ['free'],
