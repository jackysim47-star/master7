+
+export async function assertCriticalDatabaseGuards(client){
+ const normalizeColumns=value=>Array.isArray(value)?value.map(String):typeof value==='string'&&value.startsWith('{')&&value.endsWith('}')?(value.slice(1,-1)?value.slice(1,-1).split(','):[]):[];
+ const tableNames=[...new Set(CRITICAL_DATABASE_GUARDS.map(item=>item.tableName))];
+ const triggerNames=[...new Set(CRITICAL_DATABASE_GUARDS.map(item=>item.triggerName))];
+ const rows=(await client.query(`SELECT n.nspname table_schema,c.relname table_name,t.tgname trigger_name,t.tgenabled enabled,t.tgtype trigger_type,p.proname function_name,pn.nspname function_schema,
+  COALESCE(ARRAY(SELECT a.attname::text FROM unnest(t.tgattr::smallint[]) WITH ORDINALITY position(attnum,ordinality)
+   JOIN pg_catalog.pg_attribute a ON a.attrelid=t.tgrelid AND a.attnum=position.attnum ORDER BY position.ordinality),'{}'::text[]) update_columns
+  FROM pg_catalog.pg_trigger t
+  JOIN pg_catalog.pg_class c ON c.oid=t.tgrelid
+  JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
+  JOIN pg_catalog.pg_proc p ON p.oid=t.tgfoid
+  JOIN pg_catalog.pg_namespace pn ON pn.oid=p.pronamespace
+  WHERE n.nspname=current_schema() AND NOT t.tgisinternal AND t.tgname=ANY($1::text[])
+  ORDER BY c.relname,t.tgname`,[triggerNames])).rows;
+ const signature=item=>`${item.tableName}.${item.triggerName}.${item.functionName}.${item.triggerType}.${item.updateColumns.join(',')}`;
+ const expected=new Set(CRITICAL_DATABASE_GUARDS.map(signature));
+ const observed=new Map();
+ for(const row of rows){
+  const key=`${String(row.table_name)}.${String(row.trigger_name)}.${String(row.function_name)}.${String(row.trigger_type)}.${normalizeColumns(row.update_columns).join(',')}`;
+  if(expected.has(key)&&String(row.function_schema)===String(row.table_schema)&&String(row.table_schema))observed.set(key,(observed.get(key)??[]).concat(String(row.enabled)));
+ }
+ const invalid=CRITICAL_DATABASE_GUARDS.filter(item=>{
+  const values=observed.get(signature(item))??[];
+  return values.length!==1||values[0]!=='O';
+ }).map(item=>`${item.tableName}.${item.triggerName}`);
+ const unexpected=rows.filter(row=>!String(row.table_schema)||String(row.function_schema)!==String(row.table_schema)||!expected.has(`${String(row.table_name)}.${String(row.trigger_name)}.${String(row.function_name)}.${String(row.trigger_type)}.${normalizeColumns(row.update_columns).join(',')}`));
+ if(invalid.length||unexpected.length||rows.length!==CRITICAL_DATABASE_GUARDS.length){
+  const details=[...invalid,...unexpected.map(row=>`${String(row.table_name)}.${String(row.trigger_name)}.${String(row.function_schema)}.${String(row.function_name)}.${String(row.trigger_type)}.${normalizeColumns(row.update_columns).join(',')}`)].sort();
+  throw new Error(`Critical database guard attestation failed (${invalid.length||unexpected.length||rows.length}/${CRITICAL_DATABASE_GUARDS.length}): ${details.join(',')||'unexpected row count'}`);
+ }
+ return {criticalDatabaseGuardsReady:true,criticalDatabaseGuardCount:CRITICAL_DATABASE_GUARDS.length,criticalDatabaseGuardTables:tableNames.length};
+}
