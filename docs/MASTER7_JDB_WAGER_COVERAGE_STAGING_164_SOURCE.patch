+import {createHash,randomUUID} from 'node:crypto';
+import type {GameProviderWager,GameProviderWagerPage} from './game-provider-adapter.ts';
+
+export type JdbWagerTimeBasis='lastModifyTime'|'gameDate';
+export type JdbWagerWindow={profileId:'jdb_myr';timeBasis:JdbWagerTimeBasis;from:number;to:number};
+export type JdbWagerClaim=JdbWagerWindow&{windowId:string;claimToken:string;fence:number;lockedUntil:number};
