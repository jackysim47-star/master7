+
+type Actor={id:string;role:string};
+type Normalized={identity:string;payload:string;roundHash:string|null;playerHash:string;gameHash:string;bet:string;win:string;settledAt:number;detailsHash:string;count:number};
+
+export class JdbWagerCoverageError extends Error{
+ readonly status:number;readonly code:string;
+ constructor(status:number,code:string){super(code);this.name='JdbWagerCoverageError';this.status=status;this.code=code;}
+}
+const fail=(status:number,code:string):never=>{throw new JdbWagerCoverageError(status,code);};
+const sha=(value:string)=>createHash('sha256').update(value).digest('hex');
+const positiveInt=(value:unknown)=>Number.isSafeInteger(value)&&Number(value)>0;
+const nonnegativeMinor=(value:unknown)=>typeof value==='string'&&/^(0|[1-9]\d{0,15})$/.test(value);
+const safeIdentifier=(value:unknown,max=256)=>typeof value==='string'&&value.length>0&&value.length<=max&&!/[\u0000-\u001f\u007f]/u.test(value);
+
+function stable(value:unknown):string{
+ if(value===null||typeof value!=='object')return JSON.stringify(value);
+ if(Array.isArray(value))return `[${value.map(stable).join(',')}]`;
+ return `{${Object.entries(value as Record<string,unknown>).sort(([a],[b])=>a.localeCompare(b)).map(([key,item])=>`${JSON.stringify(key)}:${stable(item)}`).join(',')}}`;
+}
+
+function validateWindow(input:JdbWagerWindow):JdbWagerWindow{
+ if(input?.profileId!=='jdb_myr')fail(400,'JDB_WAGER_PROFILE_INVALID');
+ if(input.timeBasis!=='lastModifyTime'&&input.timeBasis!=='gameDate')fail(400,'JDB_WAGER_TIME_BASIS_INVALID');
